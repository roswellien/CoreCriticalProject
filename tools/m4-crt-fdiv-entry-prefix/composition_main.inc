constexpr std::array<unsigned,11>composition_pages{0x78004000,0x78011000,0x7802c000,0x7802e000,0x7802f000,0x78030000,0x78037000,0x20001000,0x5bb000,0x736000,0x9a1000};
void fresh_output(const std::filesystem::path&path,std::span<const std::byte>bytes){HANDLE f=CreateFileW(path.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);require(f!=INVALID_HANDLE_VALUE,"Fresh composition output required");DWORD written{};const bool good=bytes.size()<=MAXDWORD&&WriteFile(f,bytes.data(),static_cast<DWORD>(bytes.size()),&written,nullptr)&&written==bytes.size();CloseHandle(f);require(good,"Complete composition output write");}
template<class T>void raw_output(const std::filesystem::path&p,const T&t){fresh_output(p,{reinterpret_cast<const std::byte*>(&t),sizeof(t)});}
void snapshot(m4_runtime::Runtime&r,const std::filesystem::path&directory,const char*name){
 auto phase=directory/name;require(std::filesystem::create_directory(phase),"Fresh phase directory");fresh_output(phase/"state.bin",r.remill_state());raw_output(phase/"runtime-cpu.bin",r.cpu());raw_output(phase/"state-cpu.bin",cpu(*reinterpret_cast<State*>(r.remill_state().data())));fresh_output(phase/"fx.bin",r.fx());
 for(auto address:composition_pages){std::array<std::byte,4096>data{};r.memory().read({address},data);fresh_output(phase/("page-"+std::to_string(address)+".bin"),data);}
 std::array<std::byte,12>globals{};r.memory().read({m4_crt::Session::provider_app_type},globals);fresh_output(phase/"crt-globals.bin",globals);
 for(auto [offset,size]:std::array<std::pair<unsigned,unsigned>,3>{{{0,4},{4,8},{0x18,4}}}){std::vector<std::byte>data(size);r.memory().read(r.fs_base().wrapping_add(offset),data);fresh_output(phase/("tib-"+std::to_string(offset)+".bin"),data);}
}
Record writer_receipt(m4_runtime::Runtime&r,fd::Registry&registry,const Input&in,const std::array<std::byte,3504>&before,const std::array<std::byte,512>&fx,const std::array<std::byte,9*4096>&memory,bool complete){
 Record record{};record.id=in.id;record.repeat=in.repeat;record.cw=in.cw;record.status=complete;record.event_count=static_cast<unsigned>(registry.events().size());record.route_count=static_cast<unsigned>(registry.routes().size());record.lookup_count=static_cast<unsigned>(registry.lookups().size());require(record.event_count<=256&&record.route_count<=3&&record.lookup_count<=3,"Bounded writer receipt");record.state_before=before;record.fx_before=fx;record.pages_before=memory;std::copy(registry.events().begin(),registry.events().end(),record.events.begin());
 for(unsigned i=0;i<record.route_count;++i){const auto&v=registry.routes()[i];record.routes[i*7+0]=v.site;record.routes[i*7+1]=v.target;record.routes[i*7+2]=v.return_pc;record.routes[i*7+3]=v.entry_esp;record.routes[i*7+4]=v.exit_esp;record.routes[i*7+5]=v.argument_bytes;record.routes[i*7+6]=v.complete;}
 for(unsigned i=0;i<record.lookup_count;++i){const auto&v=registry.lookups()[i];record.lookups[i]={v.kind,v.guest_token,v.argument,v.raw_result,v.last_error,v.host_result,api(v.before),api(v.after),module(v.module)};}
 std::memcpy(record.state_after.data(),r.remill_state().data(),3504);std::memcpy(record.fx_after.data(),r.fx().data(),512);record.host_before=registry.host_before();record.host_after=registry.host_after();record.env_before=registry.host_env_before();record.env_after=registry.host_env_after();pages(r,record.pages_after);return record;
}
