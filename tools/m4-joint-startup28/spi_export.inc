 const auto named_path=path(named),owner_path=path(owner_module);const auto named_bytes=read(named_path),owner_bytes=read(owner_path);const auto entry=native_export(named_bytes,"SystemParametersInfoA");const auto resolved=reinterpret_cast<std::uintptr_t>(GetProcAddress(named,"SystemParametersInfoA"));if(resolved!=actual)throw std::runtime_error("SPI actual requested named function pointer differs");
