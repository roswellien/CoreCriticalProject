void*Session::jump(State*s,unsigned pc){guard();if(s!=&s_||s_.gpr.rip.dword!=pc||step_||s_.gpr.rsp.dword!=frame_)deny("SPI exact literal tail route rejected");if(pc==0x482d00)return mw34_spi_thunk_body(s,pc,this);if(pc==0x482cc0)return mw34_spi_helper_body(s,pc,this);deny("SPI unresolved literal tail target",pc);}
}
extern "C" void*mw34_spi_missing(State*s,unsigned pc,void*p){return mw34_spi_jump(s,pc,p);}
