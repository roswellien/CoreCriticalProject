 else{auto dot=entry.forward.find('.');if(dot==std::string::npos||!dot||dot+1>=entry.forward.size())throw std::runtime_error("SPI bounded PE forwarder required");auto module=entry.forward.substr(0,dot);alias=entry.forward.substr(dot+1);if(alias[0]=='#')throw std::runtime_error("SPI ordinal forwarder not admitted");std::wstring wmodule(module.begin(),module.end());wmodule+=L".dll";if(GetModuleHandleW(wmodule.c_str())!=owner_module)throw std::runtime_error("SPI actual forwarder owner module differs");}
