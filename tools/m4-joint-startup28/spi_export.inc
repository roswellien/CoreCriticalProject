 auto text=[&](unsigned rva){auto p=offset(rva,1);std::string s;for(unsigned i=0;i<4096;++i){if(p+i>=b.size())throw std::invalid_argument("SPI native export text bounds");char c=static_cast<char>(std::to_integer<unsigned char>(b[p+i]));if(!c)return s;s.push_back(c);}throw std::invalid_argument("SPI native export termination required");};
 const auto dir=u32(opt+112),extent=u32(opt+116),p=offset(dir,40),functions=u32(p+20),names=u32(p+24),fp=u32(p+28),np=u32(p+32),ord=u32(p+36);if(!functions||!names||functions>65536||names>65536)throw std::invalid_argument("SPI native export bounded arrays required");
 NamedExport result;unsigned found{};for(unsigned i=0;i<names;++i){if(text(u32(offset(np+4*i,4)))!=name)continue;const auto index=u16(offset(ord+2*i,2));if(index>=functions)throw std::invalid_argument("SPI native export ordinal bounds");result.rva=u32(offset(fp+4*index,4));if(result.rva>=dir&&std::uint64_t(result.rva)<std::uint64_t(dir)+extent)result.forward=text(result.rva);++found;}if(found!=1||!result.rva)throw std::invalid_argument("SPI unique named export required");return result;
}
ExportProof prove_export(Query fn){
