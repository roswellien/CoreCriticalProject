@@ -15,0 +21,15 @@ bool SdlWindow::init(bool hidden_for_good, SDL_Window* adopt) {
+  if (cc.vulkan) {
+#ifdef CC_MW3_RE_ADAPTER
+    window_ = adopt ? adopt : SDL_CreateWindow("MechWarrior 3", 1280, 960, SDL_WINDOW_HIDDEN | SDL_WINDOW_RESIZABLE);
