diff --git a/CMakeLists.txt b/CMakeLists.txt
index c50ddc1..8a390bb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -806,0 +807,25 @@ endif()
+
+if(CC_MW3_RE_ADAPTER)
+  if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT TARGET mw3)
+    message(FATAL_ERROR "The Core Critical adapter needs Windows x64 and the SDL game target")
+  endif()
+  get_filename_component(cc_root "${CC_MW3_RE_ADAPTER}/../.." ABSOLUTE)
+  add_library(cc_mw3_re_adapter OBJECT "${CC_MW3_RE_ADAPTER}/frame_renderer.cpp")
+  target_compile_features(cc_mw3_re_adapter PRIVATE cxx_std_20)
+  foreach(target cc_mw3_re_adapter mw3core mw3sdl mw3text mw3)
+    target_compile_options(${target} PRIVATE /EHsc)
+  endforeach()
+  target_compile_definitions(cc_mw3_re_adapter PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
+  target_include_directories(cc_mw3_re_adapter PRIVATE src "${CC_VULKAN_HEADERS}"
+      "${cc_root}/tools/m4-crt-heap-carry/host")
+  target_link_libraries(cc_mw3_re_adapter PRIVATE SDL3::SDL3)
+  target_sources(mw3sdl PRIVATE $<TARGET_OBJECTS:cc_mw3_re_adapter>)
+  target_compile_definitions(mw3sdl PRIVATE CC_MW3_RE_ADAPTER=1)
+  target_include_directories(mw3sdl PRIVATE "${CC_MW3_RE_ADAPTER}")
+  target_link_libraries(mw3sdl PUBLIC user32 gdi32 dxgi d3d11)
+  add_executable(cc_mw3_re_adapter_checks "${CC_MW3_RE_ADAPTER}/adapter_checks.cpp")
+  target_compile_options(cc_mw3_re_adapter_checks PRIVATE /EHsc)
+  target_include_directories(cc_mw3_re_adapter_checks PRIVATE src)
+  target_link_libraries(cc_mw3_re_adapter_checks PRIVATE mw3sdl)
+  add_test(NAME cc_mw3_re_adapter COMMAND cc_mw3_re_adapter_checks)
+endif()
