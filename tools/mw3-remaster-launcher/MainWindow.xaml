<Window x:Class="MW3RemasterLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MechWarrior 3 Remastered" Height="720" Width="1080"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushGround}"
        Foreground="{StaticResource BrushInk}"
        FontFamily="{StaticResource FontBody}"
        Icon="Assets/app-icon.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        StateChanged="MainWindow_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" Background="{StaticResource BrushGround}">
        <Grid>
            <!-- Background Surface Texture Overlay -->
            <Image Source="pack://application:,,,/Assets/Plates/surface-texture.png"
                   Stretch="Fill" Opacity="0.12" IsHitTestVisible="False" />

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Custom Title Bar -->
                    <RowDefinition Height="Auto" /> <!-- Nav Bar Tabs -->
                    <RowDefinition Height="*" />    <!-- Main Content Area -->
                    <RowDefinition Height="Auto" /> <!-- Bottom Action Rail -->
                </Grid.RowDefinitions>

                <!-- 1. Custom Title Bar / Header with Brand & Window Controls -->
                <Border Grid.Row="0" Background="#101414" BorderBrush="{StaticResource BrushRule}" BorderThickness="0,0,0,1" Height="46">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Brand / Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Image Source="pack://application:,,,/Assets/Plates/brand-mark.png" Width="26" Height="26" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MECHWARRIOR 3" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="Black" Foreground="{StaticResource BrushInk}" />
                                <TextBlock x:Name="TxtHeaderMode" Text="NATIVE REMASTER" FontFamily="{StaticResource FontHeader}" FontSize="10" Foreground="{StaticResource BrushAmber}" Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Empty drag region (WindowChrome handles window move) -->

                        <!-- Right: Game Status & Change Folder button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtGameDetected" Text="Detecting MW3..." FontSize="11" Foreground="{StaticResource BrushAmber}" />
                            </Border>
                            <Button Content="Change Folder..." Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Click="BtnBrowseGamePath_Click" ToolTip="Select MechWarrior 3 install folder or Mech3.exe" />
                        </StackPanel>

                        <!-- Far Right: Minimize, Maximize/Restore, Close -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="BtnWinMinimize" Content="&#x2014;" Style="{StaticResource WindowChromeButtonStyle}" Click="BtnWinMinimize_Click" ToolTip="Minimize" />
                            <Button x:Name="BtnWinMaximize" Content="&#x25A1;" Style="{StaticResource WindowChromeButtonStyle}" Click="BtnWinMaximize_Click" ToolTip="Maximize" />
                            <Button x:Name="BtnWinClose" Content="&#x2715;" Style="{StaticResource WindowChromeCloseButtonStyle}" Click="BtnWinClose_Click" ToolTip="Close" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Nav Bar Tabs -->
            <Border Grid.Row="1" Background="#161B1B" BorderBrush="{StaticResource BrushRule}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <RadioButton x:Name="TabPlay" Content="DASHBOARD" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabGraphics" Content="GRAPHICS &amp; DISPLAY" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabMods" Content="MODS &amp; PACKS" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabPhotoReplay" Content="PHOTO &amp; REPLAY" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabSettings" Content="SETTINGS &amp; STEAM" Style="{StaticResource NavTabStyle}" Checked="Tab_Checked" />
                </StackPanel>
            </Border>

            <!-- 3. Main Content Views Area -->
            <Grid Grid.Row="2" Margin="24,20">

                <!-- VIEW 1: PLAY DASHBOARD -->
                <Grid x:Name="ViewPlay" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Hero Display with Mad Cat render -->
                    <Border Grid.Column="0" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/Plates/hero-art.png" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.85" />
                            <Border Background="#C0101414" VerticalAlignment="Bottom" Padding="20">
                                <StackPanel>
                                    <!-- Engine Selection Switch -->
                                    <Border Background="#121717" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="3" Margin="0,0,0,12" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioEngineRemaster" Content="★ NATIVE REMASTER" Style="{StaticResource EngineToggleStyle}" IsChecked="True" Checked="EngineRadio_Checked" ToolTip="Clean-room recompiled native host with unlocked 60+ FPS, modern models, normal maps, and DVR" />
                                            <RadioButton x:Name="RadioEngineD7vk" Content="⚙ ORIGINAL GAME (D7VK)" Style="{StaticResource EngineToggleStyle}" Checked="EngineRadio_Checked" ToolTip="Original 1999 Mech3.exe running via D7VK DirectDraw/Vulkan wrapper with widescreen FOV fix and AI textures" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtHeroBadge" Text="NATIVE VULKAN RECOMPILATION" FontFamily="{StaticResource FontHeader}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtHeroTitle" Text="MechWarrior 3 Remastered" FontFamily="{StaticResource FontDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock x:Name="TxtHeroDesc" Text="Faithful original gameplay running at unlocked framerates, 4K &amp; Ultrawide resolutions, modern lighting, and modular asset replacements."
                                               FontSize="13" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="18" />

                                    <!-- Prominent Alert when MechWarrior 3 is not detected -->
                                    <Border x:Name="BorderGameMissingAlert" Background="#2C1B14" BorderBrush="{StaticResource BrushAmber}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="⚠ MECHWARRIOR 3 NOT DETECTED" FontFamily="{StaticResource FontDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAmber}" />
                                                <TextBlock Text="Click Browse to select your original game folder or Mech3.exe." FontSize="12" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource PrimaryLaunchButton}" FontSize="12" Padding="14,6" Margin="12,0,0,0" Click="BtnBrowseGamePath_Click" />
                                        </Grid>
                                    </Border>

                                    <Button x:Name="BtnLaunchGame" Content="▶  LAUNCH REMASTER" Style="{StaticResource PrimaryLaunchButton}" HorizontalAlignment="Left" Click="BtnLaunchGame_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Quick Status & Profile Overview -->
                    <Border Grid.Column="2" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ACTIVE RUNTIME PROFILE" FontFamily="{StaticResource FontHeader}" FontSize="14" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,16" />

                            <!-- Remaster Summary Profile -->
                            <StackPanel x:Name="PanelSummaryRemaster" Visibility="Visible">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Display Resolution:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryResolution" Text="1920x1080 (Full Screen)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Anti-Aliasing &amp; Texture Filtering:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryAA" Text="FXAA, 16x Anisotropic" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Scenery Draw Distance:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryDrawDist" Text="2400m (Epic Distance)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Active Asset Packs:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryPacks" Text="3 Packs Enabled" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushAmber}" />
                                </StackPanel>

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="QUICK LAUNCH TIP:" FontFamily="{StaticResource FontDisplay}" FontSize="11" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,4" />
                                        <TextBlock Text="Press F11 during missions for Photo Mode &amp; Free Cam. Press Shift + F11 for Replay timeline rewind. Press F9 for Screenshot." FontSize="12" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- D7VK Summary Profile -->
                            <StackPanel x:Name="PanelSummaryD7vk" Visibility="Collapsed">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="D7VK Resolution &amp; Aspect:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryD7vkRes" Text="1920x1080 (16:9 Widescreen)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="D7VK Anti-Aliasing &amp; Filtering:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryD7vkAA" Text="Off, 16x Anisotropic" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="High-Res Texture Banks:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock x:Name="TxtSummaryD7vkTextures" Text="39 AI-Upscaled Banks Loaded" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushAmber}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Simulation Frame Cap:" FontSize="12" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock Text="30 FPS Fixed (Required for Mech3 Physics)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" />
                                </StackPanel>

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="D7VK WRAPPER ARCHITECTURE:" FontFamily="{StaticResource FontDisplay}" FontSize="11" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,4" />
                                        <TextBlock Text="Translates DirectDraw calls to Vulkan with verified 3D camera FOV injection and isolated registry restoration on exit." FontSize="12" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VIEW 2: GRAPHICS & DISPLAY -->
                <Grid x:Name="ViewGraphics" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock Text="GRAPHICS &amp; DISPLAY SETTINGS" FontFamily="{StaticResource FontHeader}" FontSize="18" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,16" />

                                <!-- Engine Mode Selector for Graphics -->
                                <Border Background="#121717" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="3" Margin="0,0,0,20" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadioGfxRemaster" Content="★ NATIVE REMASTER GRAPHICS" Style="{StaticResource EngineToggleStyle}" IsChecked="True" Checked="GfxEngineRadio_Checked" />
                                        <RadioButton x:Name="RadioGfxD7vk" Content="⚙ ORIGINAL D7VK WRAPPER GRAPHICS" Style="{StaticResource EngineToggleStyle}" Checked="GfxEngineRadio_Checked" />
                                    </StackPanel>
                                </Border>

                                <!-- PANEL A: REMASTER GRAPHICS -->
                                <StackPanel x:Name="PanelRemasterGraphics" Visibility="Visible">
                                    <!-- Display Window Mode -->
                                    <TextBlock Text="Display Window Mode:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboWindowMode" Margin="0,0,0,16" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="Fullscreen Windowed / Borderless (Seamless Alt-Tab, Recommended)" Tag="fullscreen_windowed" />
                                        <ComboBoxItem Content="Fullscreen Exclusive" Tag="fullscreen" />
                                        <ComboBoxItem Content="Windowed (Movable Window with Title Bar)" Tag="windowed" />
                                    </ComboBox>

                                    <!-- Resolution -->
                                    <TextBlock Text="Target Resolution:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboResolution" Margin="0,0,0,16" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="1280x720 (720p 16:9 Windowed / Compact)" Tag="1280x720" />
                                        <ComboBoxItem Content="1600x900 (900p 16:9 Windowed)" Tag="1600x900" />
                                        <ComboBoxItem Content="1920x1080 (1080p 16:9 Full HD)" Tag="1920x1080" />
                                        <ComboBoxItem Content="2560x1440 (1440p 16:9 QHD)" Tag="2560x1440" />
                                        <ComboBoxItem Content="3440x1440 (Ultrawide 21:9 UWQHD)" Tag="3440x1440" />
                                        <ComboBoxItem Content="3840x2160 (4K UHD 16:9)" Tag="3840x2160" />
                                        <ComboBoxItem Content="5120x1440 (Super Ultrawide 32:9)" Tag="5120x1440" />
                                        <ComboBoxItem Content="1920x1440 (1440p 4:3 CRT Equivalent)" Tag="1920x1440" />
                                    </ComboBox>

                                    <!-- Anti-Aliasing -->
                                    <TextBlock Text="Anti-Aliasing (AA):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboAA" Margin="0,0,0,16" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="FXAA (Fast Approximate Anti-Aliasing)" Tag="fxaa" />
                                        <ComboBoxItem Content="2x Supersampling (2x SSAA)" Tag="2" />
                                        <ComboBoxItem Content="4x Supersampling (4x SSAA)" Tag="4" />
                                        <ComboBoxItem Content="Off (Pure 1:1 Pixels)" Tag="off" />
                                    </ComboBox>

                                    <!-- Anisotropic Filtering -->
                                    <TextBlock Text="Anisotropic Texture Filtering (AF):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboAF" Margin="0,0,0,16" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="16x Anisotropic (Ultra Sharp Ground Textures)" Tag="16" />
                                        <ComboBoxItem Content="8x Anisotropic" Tag="8" />
                                        <ComboBoxItem Content="4x Anisotropic" Tag="4" />
                                        <ComboBoxItem Content="Off (1x Trilinear)" Tag="1" />
                                    </ComboBox>

                                    <!-- Scenery Draw Distance -->
                                    <TextBlock Text="Scenery Draw Distance:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboDrawDist" Margin="0,0,0,16" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="3200m - Horizon Maximum (Modern High-End)" Tag="3200" />
                                        <ComboBoxItem Content="2400m - Epic Distance (Recommended)" Tag="2400" />
                                        <ComboBoxItem Content="1600m - Extended Distance" Tag="1600" />
                                        <ComboBoxItem Content="1200m - High Distance" Tag="1200" />
                                        <ComboBoxItem Content="800m - Original 1999 Classic Distance" Tag="800" />
                                    </ComboBox>

                                    <!-- Horizon Fog Distance -->
                                    <TextBlock Text="Atmospheric Horizon Fog:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboFog" Margin="0,0,0,24" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="Extended Horizon (1100m Fog Falloff)" Tag="1100" />
                                        <ComboBoxItem Content="Original Fog Atmosphere (Classic Fog Density)" Tag="0" />
                                    </ComboBox>

                                    <!-- CD Audio Music -->
                                    <CheckBox x:Name="ChkCdAudio" Content="Enable High-Fidelity CD Audio Soundtrack (In-Mission Red Book Music)" Margin="0,0,0,16" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                </StackPanel>

                                <!-- PANEL B: D7VK WRAPPER GRAPHICS -->
                                <StackPanel x:Name="PanelD7vkGraphics" Visibility="Collapsed">
                                    <TextBlock Text="ORIGINAL GAME D7VK VULKAN SETTINGS" FontFamily="{StaticResource FontHeader}" FontSize="15" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,16" />

                                    <!-- D7VK Resolution -->
                                    <TextBlock Text="Target Display Resolution &amp; Aspect Ratio:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboD7vkResolution" Margin="0,0,0,6" SelectionChanged="D7vkSettingControl_Changed">
                                        <ComboBoxItem Content="1920x1080 (1080p Widescreen 16:9)" Tag="1920x1080 (1080p Widescreen 16:9)" />
                                        <ComboBoxItem Content="2560x1440 (1440p Widescreen 16:9)" Tag="2560x1440 (1440p Widescreen 16:9)" />
                                        <ComboBoxItem Content="3440x1440 (Ultrawide 21:9)" Tag="3440x1440 (Ultrawide 21:9)" />
                                        <ComboBoxItem Content="3840x2160 (4K Widescreen 16:9)" Tag="3840x2160 (4K Widescreen 16:9)" />
                                        <ComboBoxItem Content="1024x768 (Native 4:3)" Tag="1024x768 (Native 4:3)" />
                                        <ComboBoxItem Content="1440x1080 (1080p 4:3 Equivalent)" Tag="1440x1080 (1080p 4:3 Equivalent)" />
                                        <ComboBoxItem Content="1920x1440 (1440p 4:3 Equivalent)" Tag="1920x1440 (1440p 4:3 Equivalent)" />
                                        <ComboBoxItem Content="2880x2160 (4K 4:3 Equivalent)" Tag="2880x2160 (4K 4:3 Equivalent)" />
                                        <ComboBoxItem Content="800x600 (Legacy 4:3)" Tag="800x600 (Legacy 4:3)" />
                                        <ComboBoxItem Content="640x480 (Legacy 4:3)" Tag="640x480 (Legacy 4:3)" />
                                    </ComboBox>
                                    <TextBlock x:Name="TxtD7vkResHint" Text="Full HD 1080p widescreen with corrected 3D camera FOV (unstretched)" FontSize="12" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,16" />

                                    <!-- D7VK AA -->
                                    <TextBlock Text="Anti-Aliasing (D7VK Multisample AA):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboD7vkAA" Margin="0,0,0,16" SelectionChanged="D7vkSettingControl_Changed">
                                        <ComboBoxItem Content="Off (Pure 1:1 Rendering)" Tag="Off" />
                                        <ComboBoxItem Content="2x MSAA (Multisample Anti-Aliasing)" Tag="2x MSAA" />
                                        <ComboBoxItem Content="4x MSAA (Recommended Smooth Edges)" Tag="4x MSAA" />
                                        <ComboBoxItem Content="8x MSAA (Maximum High-Fidelity)" Tag="8x MSAA" />
                                    </ComboBox>

                                    <!-- D7VK AF -->
                                    <TextBlock Text="Anisotropic Texture Filtering (DXVK Sampler AF):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="ComboD7vkAF" Margin="0,0,0,16" SelectionChanged="D7vkSettingControl_Changed">
                                        <ComboBoxItem Content="16x Anisotropic (Ultra Sharp Ground Textures)" Tag="16x" />
                                        <ComboBoxItem Content="8x Anisotropic" Tag="8x" />
                                        <ComboBoxItem Content="4x Anisotropic" Tag="4x" />
                                        <ComboBoxItem Content="2x Anisotropic" Tag="2x" />
                                        <ComboBoxItem Content="Game default (1x Trilinear)" Tag="Game default" />
                                    </ComboBox>

                                    <!-- D7VK AI Textures Checkbox -->
                                    <CheckBox x:Name="ChkD7vkAiTextures" Content="Load AI-Upscaled Textures (39 High-Definition Banks)" Margin="0,0,0,6" Checked="D7vkSettingControl_Changed" Unchecked="D7vkSettingControl_Changed" />
                                    <TextBlock Text="Applies verified cumulative AI .zbd banks using fast NTFS hard-links and automatic TextureMemory_HW = 6 configuration." FontSize="11" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,20" />

                                    <!-- D7VK Architecture & Safety Guardrails Box -->
                                    <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="D7VK WRAPPER ARCHITECTURE &amp; SAFEGUARDS" FontFamily="{StaticResource FontDisplay}" FontSize="12" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,8" />
                                            <TextBlock Text="• 30 FPS Frame Ceiling: Fixed in dxvk.conf (d3d9.maxFrameRate = 30) to preserve original game simulation and physics timings.&#x0a;• Widescreen Camera FOV Injection: Automatically stages MechWarrior3FOVFix.asi and injects into Mech3.exe on launch to prevent stretching.&#x0a;• Safe InGameVMode Clamp: Sets registry InGameVMode to 7 to prevent retail surface-loss crash at 0x00577648.&#x0a;• Registry Isolation &amp; Auto-Revert: Registry settings are saved before launch and cleanly restored on game process exit."
                                                       FontSize="12" Foreground="{StaticResource BrushInk}" LineHeight="20" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VIEW 3: MODS & ASSET PACKS -->
                <Grid x:Name="ViewMods" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar for Mods -->
                    <Border Grid.Row="0" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="MODS &amp; ASSET PACKS MANAGER" FontFamily="{StaticResource FontHeader}" FontSize="15" Foreground="{StaticResource BrushAmber}" />
                                <TextBlock Text="Drag &amp; drop .mw3pack files anywhere onto this window, or use the buttons to install and reorder packs." FontSize="12" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnInspectConflicts" Content="Inspect Conflicts" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnInspectConflicts_Click" />
                                <Button x:Name="BtnOpenModsFolder" Content="Open Mods Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnOpenModsFolder_Click" />
                                <Button x:Name="BtnInstallPack" Content="+ Install New Pack..." Style="{StaticResource PrimaryLaunchButton}" Click="BtnInstallPack_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mods List with Priority & Checkbox -->
                    <Border Grid.Row="1" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <ListView x:Name="ListPacks" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushInk}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C2121" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox to Enable/Disable -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,16,0" Click="PackCheckbox_Click" />

                                            <!-- Pack Information -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushInk}" />
                                                    <Border Background="#2A3030" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource BrushAmber}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="8,2,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="11" Foreground="#888880" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Priority Reordering Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                                <Button Content="▲" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnMoveUp_Click" Tag="{Binding}" ToolTip="Move Up in Priority (Load First)" />
                                                <Button Content="▼" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnMoveDown_Click" Tag="{Binding}" ToolTip="Move Down in Priority" />
                                            </StackPanel>

                                            <!-- Delete / Uninstall Button -->
                                            <Button Grid.Column="3" Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,4" Foreground="#E06060" Click="BtnUninstallPack_Click" Tag="{Binding}" ToolTip="Uninstall / Delete this pack" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- VIEW 4: PHOTO & REPLAY -->
                <Grid x:Name="ViewPhotoReplay" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="PHOTO &amp; REPLAY MODE CHEAT SHEET" FontFamily="{StaticResource FontHeader}" FontSize="18" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,16" />
                                <TextBlock Text="Capture cinematic screenshots and video recordings from any camera angle, playback speed, or mission moment." FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,20" />

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="INSTANT REPLAY &amp; SCREENSHOT OPTIONS" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,10" />
                                        <CheckBox x:Name="ChkInstantReplay" Content="Enable 60s Instant Replay Background Buffer (Press F10 in game to save clip)" Margin="0,0,0,8" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                        <TextBlock Text="Off by default. Enabling the rolling 60-second video buffer has a 30–35% performance impact; the actual cost varies by system and scene. Press F10 to save a clip to local/replays/." FontSize="11" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="CORE MODE CONTROLS" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,10" />
                                        <TextBlock Text="• F11: Toggle Photo Mode (freezes action, detaches camera into 6-DOF Free Cam)&#x0a;• Shift + F11: Toggle In-Engine Rewind Replay (scrub timeline, slow-mo, rewind, free cam)&#x0a;• F10: Instant Replay (saves the last 60s of gameplay as an MP4 clip to local/replays/)&#x0a;• F9: Save Lossless PNG Screenshot to local/screenshots/ (no in-game conflicts)&#x0a;• Shift + F9: Start / Stop Continuous 60 FPS MP4 Video Recording to local/videos/&#x0a;• C: Cycle Camera Mode (Free-Fly Cam → Orbit Target Cam → Dolly Spline → Cockpit)&#x0a;• H: Toggle HUD &amp; Cockpit (renders player exterior mech for clean action shots)&#x0a;• F1: Show / Hide on-screen status legend (auto-excluded from screenshots/video)&#x0a;• ESC: Exit Photo Mode / Free Cam / Replay and return to live gameplay"
                                                   FontSize="13" Foreground="{StaticResource BrushInk}" LineHeight="22" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="CAMERA NAVIGATION (FREE CAM &amp; ORBIT)" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,10" />
                                        <TextBlock Text="• WASD: Move forward/backward/strafe (adjust orbit radius in Orbit Mode)&#x0a;• Q / E (or Space / Ctrl): Elevate camera up and down&#x0a;• Mouse: Look (yaw / pitch)&#x0a;• Mouse Wheel: Telephoto / Wide-angle FOV zoom (Shift + Wheel scales speed)&#x0a;• Tab: Cycle Orbit target through all friendly &amp; enemy mechs in the mission"
                                                   FontSize="13" Foreground="{StaticResource BrushInk}" LineHeight="22" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="TIMELINE &amp; CAPTURE" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,10" />
                                        <TextBlock Text="• Space: Pause / Resume replay or simulation&#x0a;• Left / Right: Scrub backward / forward (Shift + Left/Right scrubs 5s)&#x0a;• 1..6: Playback speeds (0.1x, 0.25x, 0.5x, 1.0x, 2.0x, 4.0x)&#x0a;• F9: Save Lossless PNG Screenshot to local/screenshots/&#x0a;• Shift + F9: Start / Stop 60 FPS MP4 Video Recording to local/videos/&#x0a;• F10: Save Last 60 Seconds Instant Replay Clip to local/replays/"
                                                   FontSize="13" Foreground="{StaticResource BrushInk}" LineHeight="22" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VIEW 5: SETTINGS & STEAM -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Border Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="24">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="SYSTEM SETTINGS &amp; STEAM INTEGRATION" FontFamily="{StaticResource FontHeader}" FontSize="18" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,20" />

                            <!-- Original Game Folder -->
                            <TextBlock Text="MechWarrior 3 Installation Directory:" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGamePath" Grid.Column="0" Background="{StaticResource BrushGroundLight}" Foreground="{StaticResource BrushInk}" BorderBrush="{StaticResource BrushRule}" Padding="10,8" FontSize="13" IsReadOnly="True" />
                                <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Click="BtnBrowseGamePath_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtValidationDetails" Text="Verifying game files..." FontSize="12" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,24" />

                            <!-- Standalone Disc-Free Media Installer -->
                            <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="STANDALONE DISC-FREE MEDIA INSTALLER" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,6" />
                                    <TextBlock Text="Import cinematic movies (VIDEO/) and disc markers from your legal game CD or .ISO image directly into your installation. Once imported, MechWarrior 3 runs completely standalone without requiring a CD in the drive." FontSize="12" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnImportMedia" Content="Import Media from ISO or CD..." Style="{StaticResource SecondaryButton}" Click="BtnImportMedia_Click" Margin="0,0,12,0" />
                                        <TextBlock x:Name="TxtMediaStatus" Text="Status: Local media check ready" FontSize="12" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar x:Name="ProgressMedia" Height="4" Background="#141717" Foreground="{StaticResource BrushAmber}" BorderThickness="0" Margin="0,10,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- Steam Integration -->
                            <Border Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="STEAM LIBRARY SHORTCUT &amp; ARTWORK" FontFamily="{StaticResource FontDisplay}" FontSize="13" Foreground="{StaticResource BrushAmber}" Margin="0,0,0,6" />
                                    <TextBlock Text="Add MechWarrior 3 Remastered directly into your Steam client as a non-Steam game with high-definition custom capsule art, banner, and logo." FontSize="12" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Button x:Name="BtnAddToSteam" Content="Add to Steam Library" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnAddToSteam_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. Bottom Action Rail -->
            <Border Grid.Row="3" Background="#101414" BorderBrush="{StaticResource BrushRule}" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusReady" Text="● GAME STATUS: READY" FontFamily="{StaticResource FontDisplay}" FontSize="12" Foreground="{StaticResource BrushAmber}" Margin="0,0,20,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Screenshots" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenScreenshots_Click" />
                        <Button Content="Replays" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenReplays_Click" />
                        <Button Content="Videos" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenVideos_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
