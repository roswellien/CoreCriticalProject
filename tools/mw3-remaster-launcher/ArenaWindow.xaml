<Window x:Class="MW3RemasterLauncher.ArenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Arena — Core Critical"
        Width="1040" Height="780"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushGround}"
        Foreground="{DynamicResource BrushInk}"
        FontFamily="{DynamicResource FontBody}"
        FontSize="13"
        Closing="ArenaWindow_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushGroundLight}" />
            <Setter Property="Foreground" Value="{StaticResource BrushInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushRule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushInk}" />
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Title & subtitle -->
            <RowDefinition Height="Auto" /> <!-- 1: Match map / time limit / time of day -->
            <RowDefinition Height="*" />    <!-- 2: Side A & Side B bot rosters -->
            <RowDefinition Height="Auto" /> <!-- 3: Seed, watch/hidden mode, logs folder, graphics summary -->
            <RowDefinition Height="Auto" /> <!-- 4: Result & replay actions -->
            <RowDefinition Height="Auto" /> <!-- 5: Bottom action bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="AI ARENA" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAmber}" />
            <TextBlock Text="Pit two AI-controlled sides against each other on a multiplayer map to test bot behavior, loadouts and pilot records."
                       Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 1. Map, Time Limit, Time of Day -->
        <Border Grid.Row="1" x:Name="PanelMatchHeader" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Arena map:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="ComboMap" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time limit (1–600 min):" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtMinutes" Text="5" MinHeight="36" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Time of day:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="ComboTimeOfDay" DisplayMemberPath="Label" SelectedValuePath="Value" />
                    <TextBlock x:Name="TxtTimeOfDayHint" Text="Needs a newer game runtime" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Side A (Blue) & Side B (Red) Rosters -->
        <Grid Grid.Row="2" x:Name="PanelSides" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side A (Blue) -->
            <Border Grid.Column="0" Background="{StaticResource BrushGroundCard}" BorderBrush="#2E5B88" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="BtnAddSideA" DockPanel.Dock="Right" Content="+ Add Mech" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Click="BtnAddSideA_Click" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="#4C9EEB" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="SIDE A (BLUE)" FontFamily="{StaticResource FontHeader}" FontSize="14" Foreground="#7CC0FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtCountSideA" Text="(1 / 8)" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chassis" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                        <TextBlock Grid.Column="2" Text="Stock Loadout" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                        <TextBlock Grid.Column="4" Text="Pilot Preset (world mission record)" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsSideA">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableMechs}" SelectedItem="{Binding SelectedMech, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLoadouts}" SelectedItem="{Binding SelectedLoadout, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <Button Grid.Column="6" Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,4" Foreground="#E06060"
                                                IsEnabled="{Binding CanRemove}" Tag="{Binding}" Click="BtnRemoveSideA_Click" ToolTip="Remove this mech from Side A" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Side B (Red) -->
            <Border Grid.Column="2" Background="{StaticResource BrushGroundCard}" BorderBrush="#88372E" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="BtnAddSideB" DockPanel.Dock="Right" Content="+ Add Mech" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Click="BtnAddSideB_Click" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="#E05A47" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="SIDE B (RED)" FontFamily="{StaticResource FontHeader}" FontSize="14" Foreground="#FF8B7C" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtCountSideB" Text="(1 / 8)" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chassis" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                        <TextBlock Grid.Column="2" Text="Stock Loadout" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                        <TextBlock Grid.Column="4" Text="Pilot Preset (world mission record)" FontSize="11" Foreground="{StaticResource BrushMuted}" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsSideB">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableMechs}" SelectedItem="{Binding SelectedMech, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLoadouts}" SelectedItem="{Binding SelectedLoadout, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" />
                                        <Button Grid.Column="6" Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,4" Foreground="#E06060"
                                                IsEnabled="{Binding CanRemove}" Tag="{Binding}" Click="BtnRemoveSideB_Click" ToolTip="Remove this mech from Side B" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Seed, Watch/Hidden Mode, Logs Folder, Graphics Summary -->
        <Border Grid.Row="3" x:Name="PanelRunOptions" Background="{StaticResource BrushGroundCard}" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Seed -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seed (0–2147483647):" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel>
                            <CheckBox x:Name="ChkRandomSeed" DockPanel.Dock="Right" Content="Random each run" VerticalAlignment="Center" Margin="10,0,0,0"
                                      Checked="ChkRandomSeed_Changed" Unchecked="ChkRandomSeed_Changed" />
                            <TextBox x:Name="TxtSeed" Text="1234567" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Watch vs Hidden -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Execution mode:" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton x:Name="RadioWatchMatch" Content="Watch match" IsChecked="True" Margin="0,0,20,0" Checked="ExecutionMode_Changed" />
                            <RadioButton x:Name="RadioRunHidden" Content="Run hidden (fast, no window)" Checked="ExecutionMode_Changed" />
                        </WrapPanel>
                        <TextBlock Text="A watched match may play out differently from the same seed run hidden."
                                   FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Logs folder:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="TxtLogsFolder" Grid.Column="1" />
                    <Button Grid.Column="3" Content="Browse…" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnBrowseLogsFolder_Click" />
                    <Button Grid.Column="5" Content="Default" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnDefaultLogsFolder_Click" />
                </Grid>

                <TextBlock x:Name="TxtGraphicsSummary" Text="Graphics: your current Play settings"
                           FontSize="12" Foreground="{StaticResource BrushAmber}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 4. Status & Match Result -->
        <Border Grid.Row="4" Background="#1C2220" BorderBrush="{StaticResource BrushRule}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Loading arena catalog from MW3-RE…" FontWeight="SemiBold" Foreground="{StaticResource BrushAmber}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtResultDetail" Text="" FontSize="12" Foreground="{StaticResource BrushInk}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtLogPath" Text="" FontSize="11" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed" />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="BtnOpenRunFolder" Content="Open folder" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="BtnOpenRunFolder_Click" />
                    <Button x:Name="BtnWatchReplay3d" Content="Watch replay (3D)" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="BtnWatchReplay3d_Click" />
                    <Button x:Name="BtnCopyCommand" Content="Copy command" Style="{StaticResource SecondaryButton}" Padding="12,6" IsEnabled="False" Click="BtnCopyCommand_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 5. Bottom Action Bar -->
        <DockPanel Grid.Row="5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BtnLoadSetup" Content="Load setup…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnLoadSetup_Click" />
                <Button x:Name="BtnSaveSetup" Content="Save setup…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnSaveSetup_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnStartMatch" Content="▶  START MATCH" Style="{StaticResource PrimaryLaunchButton}" FontSize="14" Padding="20,9" Margin="0,0,10,0" IsEnabled="False" Click="BtnStartMatch_Click" />
                <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecondaryButton}" Padding="16,9" Click="BtnClose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
