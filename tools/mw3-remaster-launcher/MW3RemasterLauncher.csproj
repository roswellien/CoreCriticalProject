<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>MechWarrior 3 Remastered</ApplicationTitle>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>MW3RemasterLauncher</AssemblyName>
    <RootNamespace>MW3RemasterLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>MW3 Remaster Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Plates\*.png" />
    <Resource Include="Assets\app-icon.ico" />
    <None Update="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
