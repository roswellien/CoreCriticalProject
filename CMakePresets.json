{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Native development build",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "default", "configurePreset": "default", "configuration": "Debug"}],
  "testPresets": [{"name": "default", "configurePreset": "default", "configuration": "Debug", "output": {"outputOnFailure": true}}]
}
