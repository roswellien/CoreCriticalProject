{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-report-v1.schema.json",
  "title": "Runtime content report, version 1",
  "description": "Contract 3 in docs/packs/contracts.md: what `mw3 --content-report` prints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "game_id", "runtime_version", "sources", "problems"],
  "properties": {
    "report_version": { "type": "string", "pattern": "^1\\.[0-9]{1,3}$" },
    "game_id": { "enum": ["mw3"] },
    "runtime_version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "sources": {
      "description": "Every pack and player mod found, sorted by origin then id.",
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "problems": {
      "description": "Problems that belong to no single source, such as an unreadable library folder.",
      "type": "array",
      "items": { "$ref": "#/$defs/problem" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "location", "used", "adds", "ticked_for", "problems"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40 },
        "origin": {
          "description": "pack: from the launcher's library. player-mod: from the write directory's mods folder.",
          "enum": ["pack", "player-mod"]
        },
        "location": { "type": "string", "minLength": 1 },
        "used": {
          "description": "False when an error leaves the whole source out.",
          "type": "boolean"
        },
        "counts_for_multiplayer": { "type": "boolean" },
        "adds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mechs": { "$ref": "#/$defs/items" },
            "weapons": { "$ref": "#/$defs/items" },
            "skins": { "$ref": "#/$defs/items" },
            "maps": { "$ref": "#/$defs/items" },
            "missions": { "$ref": "#/$defs/items" },
            "campaigns": { "$ref": "#/$defs/items" },
            "visuals": { "$ref": "#/$defs/items" }
          }
        },
        "ticked_for": {
          "description": "Campaign entry ids, for example ia and mp.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/problem" } }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "description": "The stable name: what a save, a tick file or another pack refers to.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": { "type": "string", "maxLength": 80 },
          "target": {
            "description": "For skins and visuals: the contract 4 target dressed.",
            "type": "string",
            "maxLength": 80
          },
          "kind": { "type": "string", "maxLength": 40 },
          "used": { "type": "boolean" }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,47}$" },
        "severity": {
          "description": "error: the item or source is left out. warning: it is used.",
          "enum": ["error", "warning"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "file": { "type": "string", "maxLength": 240 },
        "line": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
